{
	"name": "grid-note",
	"version": "2.2.0",
	"description": "将 Markdown 转换阅读更专注和高效的树形表格视图。",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"build": "svelte-check --tsconfig ./tsconfig.json && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run",
		"test:extended": "GRIDNOTE_TEST_SCOPE=extended vitest run"
	},
	"keywords": [],
	"author": "ChengDong Xu",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "9.30.1",
		"@types/node": "^20.19.0",
		"esbuild": "0.25.5",
		"esbuild-svelte": "^0.9.4",
		"eslint-plugin-obsidianmd": "0.1.9",
		"globals": "14.0.0",
		"jiti": "2.6.1",
		"svelte-check": "^4.4.5",
		"svelte-preprocess": "^6.0.3",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.35.1",
		"vitest": "^3.2.4"
	},
	"dependencies": {
		"@codemirror/state": "^6.7.6",
		"@xuchengdong/cardtree-svelte": "^0.3.2",
		"@zumer/snapdom": "^1.9.14",
		"obsidian": "1.8.7",
		"spatial-navigation-js": "^1.0.0",
		"svelte": "^4.2.20"
	}
}
